# Skylark BI Agent - Server Environment Configuration

# Server Port
PORT=5000

# Monday.com Integration (GraphQL API v2)
# Get your API key from Monday.com -> Admin / Developer -> API Token
MONDAY_API_KEY=

# Optional: Specific Monday.com Board IDs (Auto-discovered if left blank)
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# Google Gemini API Key
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model Name (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
